# Merge these settings into your existing .env; keep model/base URL settings.
# Replace old assignments rather than adding duplicate variable names.
GEMINI_KEY_MODE=auto
GEMINI_API_KEY_1=YOUR_FIRST_KEY
GEMINI_API_KEY_2=YOUR_SECOND_KEY
# Add _3, _4, etc. as needed; numbering gaps are supported.
# Auto mode ignores GEMINI_KEY_SLOT. The legacy GEMINI_API_KEY is also included
# after numbered keys, unless its value duplicates one of them.

# Optional: use the SAME actual project ID for keys sharing a Google project.
# Do not invent distinct labels to represent independent quotas.
# GEMINI_PROJECT_ID_1=your-google-project-id
# GEMINI_PROJECT_ID_2=your-google-project-id

GEMINI_MIN_INTERVAL_SECONDS=6
GEMINI_MAX_RETRIES=2
GEMINI_MAX_RETRY_WAIT_SECONDS=120
GEMINI_RETRY_BASE_SECONDS=15
REQUEST_TIMEOUT=300

# Preserve your working COACH_PROVIDER and GEMINI_MODEL.
# MODEL_B_PROVIDER=gemini
# MODEL_B=<a different model ID available to your account>
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=<your available judge model ID>
