# Copy to .env. Never commit keys. Model names are supplied by you, not assumed available.
COACH_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=YOUR_INSTALLED_MODEL
GEMINI_API_KEY=
# An optional openai: prefix is stripped by the Gemini adapter.
GEMINI_MODEL=openai:YOUR_AVAILABLE_GEMINI_MODEL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Independent evaluation client. Prefer a different judge model.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=YOUR_AVAILABLE_JUDGE_MODEL
MODEL_B_PROVIDER=gemini
MODEL_B=YOUR_AVAILABLE_SECOND_MODEL
REQUEST_TIMEOUT=120
