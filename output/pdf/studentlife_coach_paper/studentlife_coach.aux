\newlabel{sec:judging}{{4.2}{6}{}{subsection.4.2}{}}
\newlabel{sec:metrics}{{4.3}{6}{}{subsection.4.3}{}}
\newlabel{tab:models}{{3}{7}{LLMs and generation settings. There is no training or fine-tuning. Critic and Memory Manager temperatures are 0.1; other coaching calls use 0.3}{table.caption.4}{}}
\newlabel{tab:categories}{{4}{7}{Full-system performance by scenario. $N_m$ is the non-null count; silence has no quality score}{table.caption.5}{}}
\newlabel{tab:human}{{5}{8}{Independent human and LLM ratings on 10 identical full-system messages. Means are shown with sample standard deviations. MAD is defined in Section~\ref {sec:metrics}; the final row first averages criteria within each message}{table.caption.6}{}}
\newlabel{tab:quality}{{6}{8}{Nine conditions on identical case definitions. $N_m$ is the scored-message count. Agreement uses allowed actions over all 20 cases; Send OK is the independent judge's appropriateness percentage over non-null messages. Quality criteria are scored 1--5}{table.caption.7}{}}
\newlabel{fig:depth-tradeoffs}{{2}{9}{Planning and reflection budget tradeoffs. Left: quality, allowed-action agreement, and mean tokens under planning maxima; right: quality, goal alignment, and tokens under reflection maxima. Tokens use the right axes. Agreement is divided by 20 for display (100\% becomes 5), not interpreted as a quality rating. Budgets are maxima; message cohorts can differ across conditions}{figure.caption.8}{}}
\newlabel{tab:efficiency}{{7}{9}{Efficiency across all cases in each condition. Latency, LLM calls, and tokens are mean $\pm $ sample SD. Actual Planner calls are per case; Critic cycles are per non-null message. Elapsed latency includes provider waits and any dependent re-execution, while judging is excluded. Remote service variability limits causal speed comparisons}{table.caption.9}{}}
